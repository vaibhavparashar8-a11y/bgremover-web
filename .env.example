# BGRemover environment variables (E:-drive policy)
# The start-*.cmd scripts set these automatically; this file documents them
# for other shells/tools. Copy to .env if a tool needs it.

# Model weight caches — keep everything off C: (see CLAUDE.md)
U2NET_HOME=E:\AIModels\u2net
HF_HOME=E:\AIModels\huggingface
TORCH_HOME=E:\AIModels\torch
PIP_CACHE_DIR=E:\pip-cache

# Backend
BGR_TMP_DIR=E:/Projects/BGRemover/data/tmp
BGR_INFERENCE_URL=http://127.0.0.1:8000

# Inference
# BGR_CONFIG=E:\Projects\BGRemover\inference\config.yaml

# Java toolchain (not on PATH by design)
JAVA_HOME=E:\Java\jdk-21.0.11+10
# Maven: E:\Maven\apache-maven-3.9.16\bin\mvn.cmd (localRepository=E:\maven-repo)
